# Copernicus Data Space Ecosystem (CDSE) / Sentinel Hub credentials.
# Create an OAuth client at https://shapps.dataspace.copernicus.eu/dashboard/
# (Account Settings -> OAuth clients). Fill these in a local .env.local file.
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=
CDSE_TOKEN_URL=https://identity.dataspace.copernicus.eu/auth/realms/CDSE/protocol/openid-connect/token
CDSE_SH_BASE_URL=https://sh.dataspace.copernicus.eu
# Optional: enables the WMTS tile proxy route (/api/tiles/{z}/{x}/{y}).
CDSE_WMTS_INSTANCE_ID=

# mock = in-memory demo catalogue, cdse = live Copernicus imagery (server-side only keys).
NEXT_PUBLIC_DATA_SOURCE=mock

# Guard rails for the free tier (70000 covers every Rajasthan district bbox).
MAX_AOI_KM2=70000
IMAGERY_CACHE_TTL_SECONDS=86400
RATE_LIMIT_PER_MIN=30
# Higher budget for XYZ tile fetches (MapLibre requests many per pan/zoom).
RATE_LIMIT_TILES_PER_MIN=240
# Optional on-disk tile cache directory (relative to repo root); blank = memory only.
TILE_CACHE_DIR=.tile-cache
# Daily cap on Copernicus Process API renders (UTC day, per server instance); 0 = unlimited.
DAILY_RENDER_BUDGET=3000

# ── Change detection (/api/compare/*) ──────────────────────────────────────
# Long-side cap (px) of the analysis grid; each analysis costs two Process renders.
# Grids below the cap run at native 10 m (never upscaled); large AOIs stay capped.
COMPARE_MAX_PX=1500
# PU cap per analysis, estimated with the official CDSE formula before fetching;
# 700 allows a full-size composite run and blocks runaway costs. 0 = unlimited.
PER_ANALYSIS_PU_LIMIT=700
# Per-IP analyses per minute.
COMPARE_RATE_LIMIT_PER_MIN=6
# Optional: enables the AI-generated summary card (server-side only; only stats text is sent).
# Get a key at https://aistudio.google.com/apikey — blank = disabled (AI_DISABLED).
GEMINI_API_KEY=
# Must be in the key's ListModels output and have free-tier quota (some 3.x flash models allow ~20 requests/day).
GEMINI_MODEL=gemini-2.5-flash
# Per-IP AI summary requests per minute.
AI_SUMMARY_RATE_LIMIT_PER_MIN=5

# ── Email report (/api/compare/email) ─────────────────────────────────────
# Delivery backend:
#   console (default) = write .eml/.html previews to .email-preview/, never send
#   smtp              = any SMTP server (Gmail app password, Brevo, gov relay)
#   resend            = Resend HTTP API (verified sending domain required)
EMAIL_PROVIDER=console
# Sender used for real deliveries: "Display Name <address@example.org>".
EMAIL_FROM=
# SMTP (EMAIL_PROVIDER=smtp): STARTTLS on 587, implicit TLS on 465.
SMTP_HOST=
SMTP_PORT=587
# "true" = implicit TLS (SMTPS, usually port 465); "false" = STARTTLS.
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Resend (EMAIL_PROVIDER=resend): API key from https://resend.com/api-keys.
RESEND_API_KEY=
# Canonical site origin used in every email link ("View on map" deep links).
# Required to send; on Vercel set it to the production URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Abuse limits (in-memory per instance — reset on cold start; see README).
EMAIL_RATE_LIMIT_PER_ADDRESS_PER_DAY=3
EMAIL_RATE_LIMIT_PER_IP_PER_DAY=10
EMAIL_DAILY_CAP=80
# Fixed-recipient mode (Sensitive on Vercel): ONE server-side address every
# report is sent to; the API then rejects any request carrying an email field.
# Blank = typed-address mode (which production refuses unless
# EMAIL_ALLOW_ANY_RECIPIENT=true below).
EMAIL_FIXED_RECIPIENT=
# "true" allows typed-address sending in production (default false — keep it
# false unless you really want visitors to choose recipients).
EMAIL_ALLOW_ANY_RECIPIENT=false
# Attach the full events.csv to each report ("true"/"false").
EMAIL_ATTACH_CSV=true
# Dev-only target for `npm run email:test` (never read by the API route).
EMAIL_TEST_RECIPIENT=
# Optional Cloudflare Turnstile anti-abuse (both blank = disabled).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
