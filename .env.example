# Copernicus Data Space Ecosystem (CDSE) / Sentinel Hub credentials.
# Create an OAuth client at https://shapps.dataspace.copernicus.eu/dashboard/
# (Account Settings -> OAuth clients). Fill these in a local .env.local file.
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=
CDSE_TOKEN_URL=https://identity.dataspace.copernicus.eu/auth/realms/CDSE/protocol/openid-connect/token
CDSE_SH_BASE_URL=https://sh.dataspace.copernicus.eu
# Optional: enables the WMTS tile proxy route (/api/tiles/{z}/{x}/{y}).
CDSE_WMTS_INSTANCE_ID=

# mock = in-memory demo catalogue, cdse = live Copernicus imagery (server-side only keys).
NEXT_PUBLIC_DATA_SOURCE=mock

# Guard rails for the free tier (70000 covers every Rajasthan district bbox).
MAX_AOI_KM2=70000
IMAGERY_CACHE_TTL_SECONDS=86400
RATE_LIMIT_PER_MIN=30
# Higher budget for XYZ tile fetches (MapLibre requests many per pan/zoom).
RATE_LIMIT_TILES_PER_MIN=240
# Optional on-disk tile cache directory (relative to repo root); blank = memory only.
TILE_CACHE_DIR=.tile-cache
# Daily cap on Copernicus Process API renders (UTC day, per server instance); 0 = unlimited.
DAILY_RENDER_BUDGET=3000

# ── Change detection (/api/compare/*) ──────────────────────────────────────
# Long-side cap (px) of the analysis grid; each analysis costs two Process renders.
# Grids below the cap run at native 10 m (never upscaled); large AOIs stay capped.
COMPARE_MAX_PX=1500
# PU cap per analysis, estimated with the official CDSE formula before fetching;
# 700 allows a full-size composite run and blocks runaway costs. 0 = unlimited.
PER_ANALYSIS_PU_LIMIT=700
# Per-IP analyses per minute.
COMPARE_RATE_LIMIT_PER_MIN=6
# Sentinel-1 SAR evidence for the fused rules (each side costs 1 extra render).
# false = optical-only fused rules. S1 never creates a built-up event alone.
S1_ENABLED=true
# ±days around each date for the S1 temporal median (one orbit direction per side).
S1_WINDOW_DAYS=6
# ESA WorldCover 2021 land-cover prior (cropland/built-up/water gating).
# Reads clipped COG windows from the official AWS bucket (CC-BY 4.0); fails
# gracefully to "off" if unreachable. No PU cost (not a Process render).
WORLDCOVER_ENABLED=true
# Change-rule mode: legacy = the shipped v1/v2 classifiers; fused (default) =
# Phase 3 rules (SAR + WorldCover + terrain evidence, 0-100 confidence);
# ml = Phase 4 trained softmax model (needs artifacts/ml/model.json from
# `npm run features && python ml/train.py`, or ML_MODEL_PATH; fails with
# CDSE_ML_MODEL_MISSING when no model exists). FUSED AND ML RUN THE V2
# COMPOSITE ENGINE — set CHANGE_RULES=legacy for CHANGE_ENGINE's rules.
CHANGE_RULES=fused
# Only applies with CHANGE_RULES=legacy (fused/ml force v2).
CHANGE_ENGINE=v1
# Optional: overrides the ml model path (default artifacts/ml/model.json).
ML_MODEL_PATH=
# Optional: enables the AI-generated summary card (server-side only; only stats text is sent).
# Get a key at https://aistudio.google.com/apikey — blank = disabled (AI_DISABLED).
GEMINI_API_KEY=
# Must be in the key's ListModels output and have free-tier quota (some 3.x flash models allow ~20 requests/day).
GEMINI_MODEL=gemini-2.5-flash
# Per-IP AI summary requests per minute.
AI_SUMMARY_RATE_LIMIT_PER_MIN=5

# ── Email report (/api/compare/email) ─────────────────────────────────────
# Delivery backend:
#   console (default) = write .eml/.html previews to .email-preview/, never send
#   smtp              = any SMTP server (Gmail app password, Brevo, gov relay)
#   resend            = Resend HTTP API (verified sending domain required)
EMAIL_PROVIDER=console
# Sender used for real deliveries: "Display Name <address@example.org>".
EMAIL_FROM=
# SMTP (EMAIL_PROVIDER=smtp): STARTTLS on 587, implicit TLS on 465.
SMTP_HOST=
SMTP_PORT=587
# "true" = implicit TLS (SMTPS, usually port 465); "false" = STARTTLS.
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Resend (EMAIL_PROVIDER=resend): API key from https://resend.com/api-keys.
RESEND_API_KEY=
# Canonical site origin used in every email link ("View on map" deep links).
# Required to send; on Vercel set it to the production URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Abuse limits (in-memory per instance — reset on cold start; see README).
EMAIL_RATE_LIMIT_PER_ADDRESS_PER_DAY=3
EMAIL_RATE_LIMIT_PER_IP_PER_DAY=10
EMAIL_DAILY_CAP=80
# Fixed-recipient mode (Sensitive on Vercel): ONE server-side address every
# report is sent to; the API then rejects any request carrying an email field.
# Blank = typed-address mode (which production refuses unless
# EMAIL_ALLOW_ANY_RECIPIENT=true below).
EMAIL_FIXED_RECIPIENT=
# "true" allows typed-address sending in production (default false — keep it
# false unless you really want visitors to choose recipients).
EMAIL_ALLOW_ANY_RECIPIENT=false
# Attach the full events.csv to each report ("true"/"false").
EMAIL_ATTACH_CSV=true
# Dev-only target for `npm run email:test` (never read by the API route).
EMAIL_TEST_RECIPIENT=
# Optional Cloudflare Turnstile anti-abuse (both blank = disabled).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Authentication & access gate (/login, /api/auth/*) ─────────────────────
# Gate every route behind a session cookie. Empty = default: true in
# production, false in dev/test. When true and SESSION_SECRET is missing the
# app FAILS CLOSED (plain "Authentication is not configured" page).
AUTH_REQUIRED=
# HS256 secret for session cookies — at least 32 random characters. REQUIRED
# whenever AUTH_REQUIRED=true; auth refuses to issue/verify sessions without
# it. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Rotating this value signs every user out. (Sensitive on Vercel.)
SESSION_SECRET=
# JSON array of SSO users, e.g.
#   [{"username":"admin","passwordHash":"scrypt$N=16384,...$...$...","displayName":"Admin"}]
# Create an entry with: npm run auth:new-user -- --username <name> [--display "Name"]
# (Sensitive on Vercel — never commit real entries.)
SSO_USERS=
# Allow "Continue as guest" sessions (true/false; default true).
GUEST_ENABLED=true
# Session lifetimes in hours (guest default 12, SSO default 168 = 7 days).
SESSION_TTL_GUEST_HOURS=12
SESSION_TTL_SSO_HOURS=168
# Guest sessions allowed per IP per hour.
AUTH_GUEST_PER_IP_PER_HOUR=20
# Access-request form (POST /api/access-request → EMAIL_FIXED_RECIPIENT).
ACCESS_REQUEST_PER_IP_PER_DAY=3
# Deployment-wide requests per UTC day, independent of EMAIL_DAILY_CAP; 0 = off.
ACCESS_REQUEST_DAILY_CAP=10

# ── Fields & cropping pattern (POST /api/fields, /api/fields/pattern) ───────
# Show the fields demo. Empty = default: enabled only when
# NEXT_PUBLIC_DATA_SOURCE=cdse (set "true" to preview in mock mode).
FIELDS_ENABLED=
# Default minimum confidence (0-100) when a request omits minConfidence.
FIELDS_MIN_CONFIDENCE=69
# Selection cap in km² (larger bboxes are rejected with AREA_TOO_LARGE).
FIELDS_MAX_KM2=25
# Features returned per response (larger sets come back with truncated=true).
FIELDS_MAX_COUNT=3000
# Group field NDVI curves with deterministic k-means (pattern endpoint only).
FIELDS_GROUPING=
# Field boundary archive + confidence raster (Fields of the World, CC BY 4.0,
# via Source Cooperative). Commented out = defaults shown here.
# FTW_PMTILES_URL=https://data.source.coop/ftw/global-data/predictions/vectors/alpha/results-by-admin-conf/admin:country_code=IN/IN_RJ.pmtiles
# FTW_CONFIDENCE_COG_URL=https://data.source.coop/ftw/global-data/predictions/confidence/confidence/prue_v1_confidence_global.tif
