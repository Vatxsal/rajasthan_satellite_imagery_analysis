{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": ".test-build",
    "module": "commonjs",
    "moduleResolution": "node",
    "jsx": "react-jsx",
    "incremental": false,
    "sourceMap": false,
    "declaration": false
  },
  "include": [
    "scripts/*.test.ts",
    "scripts/validate.ts",
    "scripts/phase6.ts",
    "scripts/features.ts",
    "scripts/email-preview.ts",
    "scripts/send-test-report.ts",
    "scripts/sharpen-measure.ts",
    "validation/**/*.ts",
    "types/*.d.ts"
  ]
}
