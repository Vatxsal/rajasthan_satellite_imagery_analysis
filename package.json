{
  "name": "rajasthan-imagery-explorer",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test .test-build/scripts/",
    "validate": "tsc -p tsconfig.test.json && node .test-build/scripts/validate.js",
    "email:preview": "tsc -p tsconfig.test.json && node .test-build/scripts/email-preview.js",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build",
    "generate:mock-data": "node scripts/generate-mock-data.mjs",
    "email:test": "tsc -p tsconfig.test.json && node .test-build/scripts/send-test-report.js"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-tooltip": "^1.1.3",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.1",
    "@turf/turf": "^7.4.0",
    "geotiff": "^3.0.5",
    "jpeg-js": "^0.4.4",
    "lucide-react": "^0.454.0",
    "maplibre-gl": "^4.7.1",
    "next": "^14.2.35",
    "nodemailer": "^10.3.1",
    "pngjs": "^7.0.0",
    "react": "^18",
    "react-dom": "^18",
    "zod": "^3.23.8",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@tailwindcss/container-queries": "^0.1.1",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/shapefile": "^0.6.4",
    "@types/topojson-client": "^3.1.5",
    "eslint": "^8",
    "eslint-config-next": "14.2.15",
    "playwright-core": "^1.64.1",
    "postcss": "^8",
    "shapefile": "^0.6.6",
    "tailwindcss": "^3.4.1",
    "topojson-client": "^3.1.0",
    "typescript": "^5"
  }
